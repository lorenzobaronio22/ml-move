{
  "name": "ml-move",
  "description": "Machine-readable catalog of the three-tier architecture: Components -> Sections -> Pages.",
  "tiers": ["component", "page"],
  "importAliases": {
    "ui": "src/components/ui (barrel)"
  },
  "components": [
    {
      "name": "Button",
      "tier": "component",
      "path": "src/components/ui/form/Button/Button.astro",
      "props": ["variant", "size", "href", "type", "loading", "class"],
      "i18nAware": false
    },
    {
      "name": "Icon",
      "tier": "component",
      "path": "src/components/ui/primitives/Icon/Icon.astro",
      "props": ["name", "size", "color", "decorative", "class"],
      "i18nAware": false
    },
    {
      "name": "Badge",
      "tier": "component",
      "path": "src/components/ui/data-display/Badge/Badge.astro",
      "props": ["variant", "size", "class"],
      "i18nAware": false
    },
    {
      "name": "Alert",
      "tier": "component",
      "path": "src/components/ui/feedback/Alert/Alert.astro",
      "props": ["variant", "dismissible", "class"],
      "i18nAware": false
    },
    {
      "name": "Card",
      "tier": "component",
      "path": "src/components/ui/data-display/Card/Card.astro",
      "props": ["hover", "class"],
      "i18nAware": false
    },
    {
      "name": "Avatar",
      "tier": "component",
      "path": "src/components/ui/data-display/Avatar/Avatar.astro",
      "props": ["name", "src", "alt", "size"],
      "i18nAware": false
    },
    {
      "name": "AvatarGroup",
      "tier": "component",
      "path": "src/components/ui/data-display/AvatarGroup/AvatarGroup.astro",
      "props": ["items", "max"],
      "i18nAware": false
    },
    {
      "name": "Table",
      "tier": "component",
      "path": "src/components/ui/data-display/Table/Table.astro",
      "props": ["class"],
      "i18nAware": false
    },
    {
      "name": "Skeleton",
      "tier": "component",
      "path": "src/components/ui/data-display/Skeleton/Skeleton.astro",
      "props": ["width", "height", "rounded"],
      "i18nAware": false
    },
    {
      "name": "Pagination",
      "tier": "component",
      "path": "src/components/ui/data-display/Pagination/Pagination.astro",
      "props": ["currentPage", "totalPages", "basePath", "query", "locale"],
      "i18nAware": true
    },
    {
      "name": "Prose",
      "tier": "component",
      "path": "src/components/ui/content/Prose/Prose.astro",
      "props": ["as", "size", "class"],
      "i18nAware": false
    },
    {
      "name": "Container",
      "tier": "component",
      "path": "src/components/ui/layout/Container/Container.astro",
      "props": ["size", "class"],
      "i18nAware": false
    },
    {
      "name": "Section",
      "tier": "component",
      "path": "src/components/ui/layout/Section/Section.astro",
      "props": ["spacing", "class"],
      "i18nAware": false
    },
    {
      "name": "Grid",
      "tier": "component",
      "path": "src/components/ui/layout/Grid/Grid.astro",
      "props": ["cols", "gap", "class"],
      "i18nAware": false
    },
    {
      "name": "Input",
      "tier": "component",
      "path": "src/components/ui/form/Input/Input.astro",
      "props": ["id", "name", "label", "type", "placeholder", "value", "helperText", "errorText", "required", "class"],
      "i18nAware": false
    },
    {
      "name": "Select",
      "tier": "component",
      "path": "src/components/ui/form/Select/Select.astro",
      "props": ["id", "name", "label", "options", "value", "helperText", "errorText", "required", "class"],
      "i18nAware": false
    },
    {
      "name": "Textarea",
      "tier": "component",
      "path": "src/components/ui/form/Textarea/Textarea.astro",
      "props": ["id", "name", "label", "rows", "placeholder", "value", "helperText", "errorText", "required", "class"],
      "i18nAware": false
    },
    {
      "name": "Checkbox",
      "tier": "component",
      "path": "src/components/ui/form/Checkbox/Checkbox.astro",
      "props": ["id", "name", "label", "checked"],
      "i18nAware": false
    },
    {
      "name": "Switch",
      "tier": "component",
      "path": "src/components/ui/form/Switch/Switch.astro",
      "props": ["id", "name", "label", "checked"],
      "i18nAware": false
    },
    {
      "name": "Logo",
      "tier": "component",
      "path": "src/components/ui/marketing/Logo/Logo.astro",
      "props": ["href"],
      "i18nAware": false
    }
  ],
  "pages": [
    { "name": "Home", "path": "src/pages/index.astro", "locales": ["en"] },
    { "name": "Home (Italian)", "path": "src/pages/[locale]/index.astro", "locales": ["it"] }
  ]
}
